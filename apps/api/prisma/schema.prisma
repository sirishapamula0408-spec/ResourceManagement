// Resource Board - initial data model (M1 + forward-compatible M2/M3 fields).
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

/// App roles from the scope plan (Users and roles).
enum Role {
  ADMIN // everything, incl. roles and integrations
  DELIVERY_HEAD // view all; edit people and projects
  RESOURCE_MANAGER // PMO: full edit on team and projects; tasks read-only
  PM // create, edit and move tasks on own projects
  MEMBER // own tasks: status and hours logged
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG // not scheduled; excluded from utilization demand
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum TaskType {
  STORY
  TASK
  BUG
  SUPPORT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum LeaveType {
  VACATION
  SICK
  PUBLIC_HOLIDAY
  TRAINING
  OTHER
}

enum AlertMetric {
  OVER_ALLOCATION // person allocated above X% of capacity
  UNDER_UTILIZATION // person allocated below X% of capacity
  PROJECT_OVER_BUDGET // project hours above planned
  TASK_OVERDUE
}

// ---------- Organisation ----------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  people    Person[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  role                Role        @default(MEMBER)
  title               String?
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  weeklyCapacityHours Decimal     @default(40) @db.Decimal(5, 2)
  passwordHash        String?
  /// Set when someone else chose the password (new person, reset); cleared when they change it.
  mustChangePassword  Boolean     @default(false)
  active              Boolean     @default(true)
  // M3: Azure AD SSO / JIRA sync identifiers
  externalId          String?     @unique
  jiraAccountId       String?     @unique

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  ownedProjects      Project[]       @relation("ProjectOwner")
  allocations        Allocation[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  worklogs           Worklog[]
  leaves             Leave[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  members     TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamMember {
  teamId   String
  personId String
  isLead   Boolean  @default(false)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([teamId, personId])
  @@index([personId])
}

// ---------- Projects & capacity ----------

model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  client      String?
  /// Splits dashboard demand into billable vs non-billable.
  billable    Boolean       @default(true)
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  ownerId     String?
  owner       Person?       @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  jiraKey     String?       @unique // M3: JIRA project key

  members     ProjectMember[]
  allocations Allocation[]
  tasks       Task[]
  epics       Epic[]
  sprints     Sprint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// A person staffed on a project (who can be assigned its work).
model ProjectMember {
  projectId String
  personId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, personId])
  @@index([personId])
}

/// Planned hours for a person on a project for one week (weekStart = Monday).
model Allocation {
  id        String   @id @default(cuid())
  personId  String
  projectId String
  weekStart DateTime @db.Date
  hours     Decimal  @db.Decimal(5, 2)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, projectId, weekStart])
  @@index([weekStart])
  @@index([projectId])
}

// ---------- Work tracking ----------

model Epic {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  jiraKey     String?  @unique
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?    @db.Date
  endDate   DateTime?    @db.Date
  jiraId    String?      @unique
  tasks     Task[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId])
}

model Task {
  id            String       @id @default(cuid())
  /// Human-readable sequence shown as the key "RB-<number>".
  number        Int          @unique @default(autoincrement())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  type          TaskType     @default(TASK)
  assigneeId    String?
  assignee      Person?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  estimateHours Decimal?     @db.Decimal(6, 2)
  /// Sort order within a board column (use gapped integers when reordering).
  order         Int          @default(0)
  /// Estimate is spread over the working days from startDate to dueDate (utilization rules).
  startDate     DateTime?    @db.Date
  dueDate       DateTime?    @db.Date
  epicId        String?
  epic          Epic?        @relation(fields: [epicId], references: [id], onDelete: SetNull)
  sprintId      String?
  sprint        Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  jiraKey       String?      @unique // M3: two-way sync
  worklogs      Worklog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, status, order])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([epicId])
}

model Worklog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  hours     Decimal  @db.Decimal(5, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, date])
  @@index([taskId])
}

/// Leave reduces a person's available capacity for the covered days (M2).
model Leave {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  type      LeaveType @default(VACATION)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([personId, startDate])
}

// ---------- Settings & compliance ----------

/// Configurable alert thresholds (M2). Global when departmentId/projectId are null.
model AlertThreshold {
  id           String      @id @default(cuid())
  metric       AlertMetric
  /// Percentage or absolute value depending on metric.
  value        Decimal     @db.Decimal(7, 2)
  enabled      Boolean     @default(true)
  departmentId String?
  projectId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([metric])
}

/// Append-only audit trail (M3).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Person?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "task.update", "auth.login"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
