# Web app settings (Vite reads VITE_* variables from apps/web/.env at build and dev time).
# Copy to apps/web/.env and adjust. All are optional.

# Show "Sign in with Microsoft (SSO)" on the sign-in page. Off until Azure AD sign-in exists.
VITE_SSO_ENABLED=false

# Email address behind "Need access? Contact your administrator". Unset: plain text, no link.
# VITE_ADMIN_EMAIL="it-support@example.com"

# Environment badge next to Help/Support on the sign-in page: DEV, UAT or PROD (PROD hides it).
# Default: DEV for `vite` (dev server), PROD for `vite build`.
# VITE_APP_ENV=UAT

# Links for "Privacy" and "Terms" in the sign-in footer. Unset: plain text.
# VITE_PRIVACY_URL="https://www.example.com/privacy"
# VITE_TERMS_URL="https://www.example.com/terms"

# The version in the footer comes from apps/web/package.json (no variable needed).
