# Web app settings (Vite reads VITE_* variables from apps/web/.env at build and dev time).
# Copy to apps/web/.env and adjust. All are optional.

# Show "Sign in with Microsoft (SSO)" on the sign-in page. Off until Azure AD sign-in exists.
VITE_SSO_ENABLED=false

# Email address behind "Need access? Contact your administrator". Unset: plain text, no link.
# VITE_ADMIN_EMAIL="it-support@example.com"
