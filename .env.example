# PostgreSQL connection (local embedded Postgres from `npm run db:start`, or docker compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/resource_board?schema=public"

# Secret used to sign JWTs. Use a long random value outside local dev.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# API port (the Vite dev server proxies /api to this port)
PORT=4100

# Allowed CORS origin for the web app (only needed when not using the Vite proxy)
CORS_ORIGIN="http://localhost:5173"
