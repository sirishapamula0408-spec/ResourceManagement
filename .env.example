# PostgreSQL connection (local embedded Postgres from `npm run db:start`, or docker compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/resource_board?schema=public"

# Secret used to sign JWTs. Use a long random value outside local dev.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# API port (the Vite dev server proxies /api to this port)
PORT=4100

# Allowed CORS origin for the web app (only needed when not using the Vite proxy)
CORS_ORIGIN="http://localhost:5173"

# Public address of the app; turns on the Claude connector at <PUBLIC_URL>/mcp.
# Defaults to http://localhost:5173 outside production. Must be HTTPS for claude.ai.
# PUBLIC_URL="https://board.example.com"

# Email domains allowed to self-register at /signup (comma-separated). Unset or empty (the default)
# turns sign-up off; admins then add people on the Team page.
# SIGNUP_DOMAINS="example.com"

# Task attachments: folder for the uploaded files (default apps/api/uploads) and the largest
# file accepted, in MB (default 10). In Docker, mount a volume at UPLOAD_DIR.
# UPLOAD_DIR="/var/lib/sedhub/uploads"
# MAX_UPLOAD_MB=10

# Key for encrypting two-step verification (authenticator) secrets, 16+ characters. Optional:
# derived from JWT_SECRET when unset. Changing it means people set up two-step verification again.
# MFA_ENCRYPTION_KEY="a-long-random-string"
