{
  "name": "resource-board",
  "version": "0.1.0",
  "private": true,
  "description": "Resource Board - internal resource management app for PMs",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @rb/api\" \"npm run dev -w @rb/web\"",
    "build": "npm run build -w @rb/api && npm run build -w @rb/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "db:start": "node scripts/db-start.mjs start",
    "db:migrate": "npm run db:migrate -w @rb/api",
    "db:deploy": "npm run db:deploy -w @rb/api",
    "db:seed": "npm run db:seed -w @rb/api",
    "db:studio": "npm run db:studio -w @rb/api",
    "db:stop": "node scripts/db-start.mjs stop",
    "db:status": "node scripts/db-start.mjs status",
    "db:reset": "npm run db:reset -w @rb/api",
    "uat:reset": "node scripts/uat.mjs reset",
    "uat:start": "node scripts/uat.mjs start",
    "e2e": "npm run build && playwright test",
    "db:demo:reports": "npm run db:demo:reports -w @rb/api --",
    "db:demo:sales": "npm run db:demo:sales -w @rb/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
